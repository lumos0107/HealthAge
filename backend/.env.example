# ─────────────────────────────────────────────
# 환경 구분
# ─────────────────────────────────────────────
ENV=development                  # development | production

# ─────────────────────────────────────────────
# Supabase — 본인 Dashboard에서 Settings → API 확인
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...     # public anon key — 프론트엔드도 사용
SUPABASE_SERVICE_ROLE_KEY=eyJ... # service_role — ⚠️ 절대 노출 금지
SUPABASE_JWT_SECRET=             # JWT Secret — HS256 검증용

# ─────────────────────────────────────────────
# CORS — 콤마 구분, 프론트엔드 도메인
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
# 분석 모듈 — 미래 분리 대비 (지금은 'local' 고정)
# ─────────────────────────────────────────────
ANALYZER_MODE=local              # local (현재) | remote (분리 후)
# ANALYZER_SERVICE_URL=https://analyzer-xxxxx.run.app   # remote 모드일 때만

# ─────────────────────────────────────────────
# OCR
# ─────────────────────────────────────────────
VISION_BACKEND=ollama            # ollama (개발) | gemini (프로덕션)

# Ollama 사용 시 (값 비우면 OCR pipeline의 config.py 기본값 사용)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:7b-q8_0

# Gemini 사용 시 (vision_backend=gemini일 때만 필수)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# 서버
# ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
